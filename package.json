{
  "name": "viafrei",
  "version": "1.5.4",
  "description": "German traffic, rail, parking, charging, fuel, address and weather data in your AI assistant - MCP, no API key. stdio bridge to the hosted ViaFrei MCP server.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "model-context-protocol",
    "stdio",
    "bridge",
    "proxy",
    "claude",
    "ai-assistant",
    "germany",
    "deutschland",
    "transport",
    "traffic",
    "autobahn",
    "deutsche-bahn",
    "departures",
    "parking",
    "ev-charging",
    "fuel-prices",
    "geocoding",
    "weather",
    "open-data"
  ],
  "homepage": "https://viafrei.de",
  "bugs": "https://github.com/mavrovde/viafrei-bridge/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mavrovde/viafrei-bridge.git"
  },
  "license": "Apache-2.0",
  "author": "ViaFrei",
  "type": "module",
  "bin": {
    "viafrei": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SOURCES.md",
    "API.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('.test-build',{recursive:true,force:true})\"",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test --test-timeout=30000 .test-build/test/*.test.js",
    "test:gate": "node scripts/check-tarball.test.mjs",
    "test:leaks": "node scripts/check-leaks.test.mjs",
    "test:tools": "node scripts/tools.test.mjs",
    "test:docs": "node scripts/gen-api-doc.test.mjs",
    "test:versions": "node scripts/check-versions.test.mjs",
    "check:tarball": "node scripts/check-tarball.mjs",
    "check:leaks": "node scripts/check-leaks.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "docs:api": "node scripts/gen-api-doc.mjs",
    "check:docs": "node scripts/gen-api-doc.mjs --check",
    "check:sources": "node scripts/check-sources.mjs",
    "test:sources": "node scripts/check-sources.test.mjs",
    "probe:catalogue": "node scripts/probe-catalogue.mjs",
    "test:probe": "node scripts/probe-catalogue.test.mjs",
    "probe:freshness": "node scripts/probe-freshness.mjs",
    "test:freshness": "node scripts/probe-freshness.test.mjs",
    "propose:release": "node scripts/propose-release.mjs",
    "test:propose": "node scripts/propose-release.test.mjs",
    "rules:show": "node scripts/show-rules.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  }
}
