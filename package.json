{
  "name": "viafrei",
  "version": "0.0.9",
  "description": "stdio<->Streamable-HTTP bridge for the ViaFrei MCP server - German road, rail, parking, charging and fuel data for stdio-only MCP clients",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "stdio",
    "bridge",
    "proxy",
    "germany",
    "transport",
    "open-data"
  ],
  "homepage": "https://viafrei.de",
  "bugs": "https://github.com/mavrovde/viafrei-bridge/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mavrovde/viafrei-bridge.git"
  },
  "license": "Apache-2.0",
  "author": "ViaFrei",
  "type": "module",
  "bin": {
    "viafrei": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SOURCES.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('.test-build',{recursive:true,force:true})\"",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test --test-timeout=30000 .test-build/test/*.test.js",
    "test:gate": "node scripts/check-tarball.test.mjs",
    "check:tarball": "node scripts/check-tarball.mjs",
    "check:leaks": "node scripts/check-leaks.mjs",
    "rules:show": "node scripts/show-rules.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  }
}
